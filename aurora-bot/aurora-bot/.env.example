# =================================================================
# 🎵 TUSSI MUSIC - BOT & BACKEND API CONFIGURATION (.env)
# =================================================================

# Enlace al servidor de soporte de Discord
SUPPORT_SERVER_LINK=https://discord.gg/zTTMRnU9G

# Token de tu Bot de Discord (Developer Portal > Bot > Reset Token)
BOT_TOKEN=tu_token_de_bot_aqui

# ID del Servidor principal de Discord (Guild ID)
GUILD_ID=tu_guild_id

# ID del Canal para logs del bot
LOG_CHANNEL_ID=tu_log_channel_id

# Webhook de Discord (Opcional, para alertas)
WEBHOOK=

# URI de conexión a MongoDB
# Para pruebas en Local: mongodb://127.0.0.1:27017/tussimusic
# Para Docker/Coolify: mongodb://mongodb:27017/tussimusic
MONGODB_URI=mongodb://127.0.0.1:27017/tussimusic

# URL del Frontend Web Dashboard
# En Local: http://localhost:3000
# En Producción/Coolify: https://tussimusic.tudominio.com
WEB_DASHBOARD_URL=http://localhost:3000

# Puerto del Servidor API / WebSockets del Bot (por defecto 3001)
BACKEND_PORT=3001

# URL de autenticación NextAuth (normalmente igual a WEB_DASHBOARD_URL)
NEXTAUTH_URL=http://localhost:3000

# Discord OAuth2 (Developer Portal > OAuth2 / General Information)
DISCORD_CLIENT_ID=tu_client_id
DISCORD_CLIENT_SECRET=tu_client_secret

# Token opcional de Top.gg para autopostear estadísticas
TOPGG_TOKEN=

# API Key opcional de Last.fm para búsqueda y metadatos extendidos
LASTFM_API_KEY=

# Configuración de Rich Presence del Bot (opcional)
RICH_PRESENCE_ENABLED=false
RICH_PRESENCE_NAME={servers} servers, 24/7 Music Playback
RICH_PRESENCE_TYPE=Watching
RICH_PRESENCE_STATUS=online
