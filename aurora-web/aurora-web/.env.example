# =================================================================
# 🌐 TUSSI MUSIC - WEB DASHBOARD CONFIGURATION (.env.local)
# =================================================================

# URL pública del Backend/WebSockets (Bot API Server)
# En Local: http://localhost:3001
# En Producción/Coolify: https://api.tussimusic.tudominio.com (o http://localhost:3001 si usas proxy)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# URL interna para comunicación en red de Docker (solo si usas Docker/Coolify)
# En Local con Docker: http://backend:3001
# Sin Docker en Local: http://localhost:3001
INTERNAL_API_URL=http://localhost:3001

# URL de callback de Discord OAuth2 (debe coincidir EXACTAMENTE con la configurada en Discord Developer Portal)
# En Local: http://localhost:3000/api/auth/discord/callback
# En Producción/Coolify: https://tussimusic.tudominio.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Credenciales de Discord OAuth2 (Developer Portal)
DISCORD_CLIENT_ID=tu_client_id
DISCORD_CLIENT_SECRET=tu_client_secret

# URL base del dashboard NextAuth
# En Local: http://localhost:3000
# En Producción/Coolify: https://tussimusic.tudominio.com
NEXTAUTH_URL=http://localhost:3000

# URI de conexión a MongoDB
# En Local: mongodb://127.0.0.1:27017/tussimusic
# En Docker/Coolify: mongodb://mongodb:27017/tussimusic
MONGODB_URI=mongodb://127.0.0.1:27017/tussimusic
